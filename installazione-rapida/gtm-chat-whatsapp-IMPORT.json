{
  "exportFormatVersion": 2,
  "containerVersion": {
    "container": {
      "usageContext": [
        "WEB"
      ]
    },
    "builtInVariable": [
      {
        "type": "CLICK_URL",
        "name": "Click URL"
      },
      {
        "type": "PAGE_HOSTNAME",
        "name": "Page Hostname"
      },
      {
        "type": "PAGE_PATH",
        "name": "Page Path"
      },
      {
        "type": "EVENT",
        "name": "Event"
      }
    ],
    "variable": [
      {
        "variableId": "9501",
        "name": "CONFIG - Chat - AW Conversion ID",
        "type": "c",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "value",
            "value": "1050072793"
          }
        ],
        "notes": "Google Ads account AW-1050072793 (already used by the container)."
      },
      {
        "variableId": "9502",
        "name": "CONFIG - Chat - AW Conversion Label",
        "type": "c",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "value",
            "value": "SOSTITUIRE-CON-ETICHETTA-CHAT"
          }
        ],
        "notes": "Google Ads > Obiettivi > Conversioni > nuova azione 'Contatto WhatsApp / chat' (secondaria) > etichetta."
      },
      {
        "variableId": "9503",
        "name": "DLV - chat_channel",
        "type": "v",
        "parameter": [
          {
            "type": "INTEGER",
            "key": "dataLayerVersion",
            "value": "2"
          },
          {
            "type": "TEMPLATE",
            "key": "name",
            "value": "chat_channel"
          }
        ]
      }
    ],
    "trigger": [
      {
        "triggerId": "9601",
        "name": "LC - Click WhatsApp",
        "type": "LINK_CLICK",
        "filter": [
          {
            "type": "MATCH_REGEX",
            "parameter": [
              {
                "type": "TEMPLATE",
                "key": "arg0",
                "value": "{{Click URL}}"
              },
              {
                "type": "TEMPLATE",
                "key": "arg1",
                "value": "wa\\.me/|api\\.whatsapp\\.com|web\\.whatsapp\\.com|^whatsapp:"
              }
            ]
          }
        ],
        "waitForTags": {
          "type": "BOOLEAN",
          "value": "false"
        },
        "checkValidation": {
          "type": "BOOLEAN",
          "value": "false"
        },
        "notes": "Ogni clic su un link WhatsApp (header, footer, schede prodotto)."
      },
      {
        "triggerId": "9602",
        "name": "CE - chat_started",
        "type": "CUSTOM_EVENT",
        "customEventFilter": [
          {
            "type": "EQUALS",
            "parameter": [
              {
                "type": "TEMPLATE",
                "key": "arg0",
                "value": "{{_event}}"
              },
              {
                "type": "TEMPLATE",
                "key": "arg1",
                "value": "chat_started"
              }
            ]
          }
        ],
        "notes": "Per una chat futura (Tidio, Crisp, ...): il widget spinge dataLayer.push({event:'chat_started', chat_channel:'tidio'}) al primo messaggio del visitatore."
      },
      {
        "triggerId": "9603",
        "name": "ESCLUSIONE - staging (tutti gli eventi)",
        "type": "CUSTOM_EVENT",
        "customEventFilter": [
          {
            "type": "MATCH_REGEX",
            "parameter": [
              {
                "type": "TEMPLATE",
                "key": "arg0",
                "value": "{{_event}}"
              },
              {
                "type": "TEMPLATE",
                "key": "arg1",
                "value": ".*"
              }
            ]
          }
        ],
        "filter": [
          {
            "type": "CONTAINS",
            "parameter": [
              {
                "type": "TEMPLATE",
                "key": "arg0",
                "value": "{{Page Hostname}}"
              },
              {
                "type": "TEMPLATE",
                "key": "arg1",
                "value": "staging."
              }
            ]
          }
        ],
        "notes": "Lo staging carica lo stesso contenitore del sito vero: senza questa eccezione i test sullo staging finiscono nell'account Google Ads reale."
      }
    ],
    "tag": [
      {
        "tagId": "9701",
        "name": "GA4 - whatsapp_click",
        "type": "gaawe",
        "parameter": [
          {
            "type": "BOOLEAN",
            "key": "sendEcommerceData",
            "value": "false"
          },
          {
            "type": "TEMPLATE",
            "key": "eventName",
            "value": "whatsapp_click"
          },
          {
            "type": "TEMPLATE",
            "key": "measurementIdOverride",
            "value": "G-L5MJ9HDMQ8"
          },
          {
            "type": "LIST",
            "key": "eventSettingsTable",
            "list": [
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "lead_type"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "whatsapp"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "link_url"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Click URL}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "page_path"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Page Path}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "server_container_url"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "https://measure.disegnarecasa.com"
                  }
                ]
              }
            ]
          }
        ],
        "firingTriggerId": [
          "9601"
        ],
        "blockingTriggerId": [
          "9603"
        ]
      },
      {
        "tagId": "9702",
        "name": "GA4 - chat_started",
        "type": "gaawe",
        "parameter": [
          {
            "type": "BOOLEAN",
            "key": "sendEcommerceData",
            "value": "false"
          },
          {
            "type": "TEMPLATE",
            "key": "eventName",
            "value": "chat_started"
          },
          {
            "type": "TEMPLATE",
            "key": "measurementIdOverride",
            "value": "G-L5MJ9HDMQ8"
          },
          {
            "type": "LIST",
            "key": "eventSettingsTable",
            "list": [
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "lead_type"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "chat"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "chat_channel"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{DLV - chat_channel}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "server_container_url"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "https://measure.disegnarecasa.com"
                  }
                ]
              }
            ]
          }
        ],
        "firingTriggerId": [
          "9602"
        ],
        "blockingTriggerId": [
          "9603"
        ]
      },
      {
        "tagId": "9703",
        "name": "AW - Conversione - Contatto WhatsApp / chat",
        "type": "awct",
        "parameter": [
          {
            "type": "BOOLEAN",
            "key": "enableConversionLinker",
            "value": "true"
          },
          {
            "type": "TEMPLATE",
            "key": "conversionId",
            "value": "{{CONFIG - Chat - AW Conversion ID}}"
          },
          {
            "type": "TEMPLATE",
            "key": "conversionLabel",
            "value": "{{CONFIG - Chat - AW Conversion Label}}"
          }
        ],
        "firingTriggerId": [
          "9601",
          "9602"
        ],
        "blockingTriggerId": [
          "9603"
        ],
        "notes": "Conversione SECONDARIA (osservazione): un clic su WhatsApp non e' ancora un lead."
      }
    ]
  }
}